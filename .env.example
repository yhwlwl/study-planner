# 浏览器端，可公开；必须配合 Supabase RLS。
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Supabase smoke / CI 使用。publishable key 可公开，但建议在 GitHub 中仍统一放 Secrets 管理。
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Vercel Function / CI full smoke 服务端专用。不要加 VITE_ 前缀，不要提交真实值。
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# 旧项目也可使用：SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY
