{
  "name": "study-planner",
  "private": true,
  "version": "0.9.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.check.json --pretty false",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:scale": "node scripts/performance-v08.mjs",
    "validate:v08": "node scripts/validate-v08.mjs",
    "test:scenarios": "node scripts/scenario-v0810.mjs",
    "test:adjustment": "node scripts/runtime-adjustment-v0810.mjs",
    "test:ui": "node scripts/ui-audit-v0810.mjs",
    "test:efficiency": "node scripts/user-efficiency-v0810.mjs",
    "test:mobile-review": "node scripts/mobile-review-layout-v0811.mjs",
    "test:mobile-proposal": "node scripts/mobile-proposal-layout-v0812.mjs",
    "test:mobile-modal": "node scripts/mobile-modal-footer-v0813.mjs",
    "test:visit-log": "node scripts/visit-log-v0815.mjs",
    "test:supabase:smoke": "node scripts/supabase-smoke.mjs",
    "test:intake": "node scripts/runtime-intake-v09.mjs",
    "test:planner-performance": "node scripts/runtime-planner-performance.mjs",
    "test:bundle": "node scripts/check-bundle.mjs",
    "test": "vitest run --pool=forks --maxWorkers=1",
    "test:coverage": "vitest run --coverage --pool=threads --maxWorkers=1",
    "test:quality": "npm run typecheck && npm test && npm run validate:v08 && npm run build && npm run test:bundle"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.52.1",
    "@vercel/analytics": "^2.0.1",
    "date-fns": "^4.1.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "read-excel-file": "^9.3.8",
    "recharts": "^2.15.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.13.0",
    "fast-check": "^4.9.0",
    "jsdom": "^29.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "^4.1.10"
  }
}
